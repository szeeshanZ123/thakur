# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./data/treasure_ledger.db

# Authentication & JWT Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500

# Initial Administrator Provisioning (for seed script)
INITIAL_ADMIN_USERNAME=captain_admin
INITIAL_ADMIN_EMAIL=admin@treasureledger.local
INITIAL_ADMIN_PASSWORD=SetAStrongPasswordHere123!

# AI / LLM Provider Keys (Fill in when using external LLM APIs)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini

# ML Paths
MODEL_SAVE_DIR=models/
DATA_DIR=data/
