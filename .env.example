# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
DEBUG=True

# CORS & Frontend Origins (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5500,http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000

# Database Configuration (SQLite default / PostgreSQL compatible)
DATABASE_URL=sqlite:///./data/treasure_ledger.db

# AI / LLM Provider Keys (Fill in when using external LLM APIs)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini

# ML Paths
MODEL_SAVE_DIR=models/
DATA_DIR=data/
